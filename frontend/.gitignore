
cat > .gitignore <<'EOF'
# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment variables
.env
.env.*
!.env.example

# Frontend
node_modules/
dist/
build/

# IDE and operating system
.vscode/
.idea/
.DS_Store
EOF

# Logs
*.log

# Local database and coverage files
*.sqlite3
.coverage
htmlcov/